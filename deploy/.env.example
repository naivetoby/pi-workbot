# 必填：Web 登录密码；请设置长随机密码，留空时 Compose 拒绝启动。
# 含 $ 或 # 等特殊字符时请用单引号包裹，例如 PI_WEB_PASSWORD='your$secret#value'。
PI_WEB_PASSWORD=

# 宿主机监听地址；默认仅本机访问，通过 SSH 隧道或 HTTPS 反向代理连接。
WORKBOT_WEB_BIND=127.0.0.1

# 宿主机 Web 端口；容器内部固定使用 30141。
WORKBOT_WEB_PORT=30141

# 额外允许的访问主机名，多个用英文逗号分隔，不含协议和端口；本机访问可留空。
PI_WEB_ALLOWED_HOSTS=

# Web 自动启动：1 开启、0 关闭；默认随 chat 启动。
WORKBOT_WEB_AUTOSTART=1

# 独立 Pi TUI 开关：1 开启、0 关闭；默认开启，与 Web 共用登录认证。
WORKBOT_TUI_ENABLED=1

# chat 默认模型的 OpenAI Responses 中转站地址（含 /v1）与 API Key。
# 地址留空时不启用中转模型；修改后需重新创建容器。
OPENAI_RELAY_BASE_URL=
OPENAI_RELAY_API_KEY=

# 可选：chat 切换到 DeepSeek 时使用；code 默认使用此凭证。
DEEPSEEK_API_KEY=

# 可选：构建所用研发底座，可替换为具备相同工具和 vscode 用户的镜像。
WORKBOT_BASE_IMAGE=naivetoby/pi-workbot-dev:latest

# 可选：GitLab 实例域名，不含协议；仅使用 Web 对话时不要求 GitLab 令牌。
GITLAB_HOST=gitlab.com

# 可选：GitLab 服务账号访问令牌；访问私有项目、Issue/MR 或派发 code 任务时需要。
GITLAB_TOKEN=

# 可选：控制项目完整路径，例如 your-group/pi-workbot；派发 code 任务时需要。
WORKBOT_CONTROL_PROJECT=

# 可选：code 流水线使用的分支或标签；留空使用控制项目默认分支。
WORKBOT_CODE_REF=

# 可选：飞书应用 ID。
FEISHU_APP_ID=

# 可选：飞书应用密钥。
FEISHU_APP_SECRET=

# 可选：企业微信机器人 ID。
WECOM_BOT_ID=

# 可选：企业微信机器人密钥。
WECOM_BOT_SECRET=

# 可选：企业微信群机器人通知 Webhook，不是 IM 接入凭证。
WECOM_BOT_URL=
