+      </div>
+      <div className="terminal-xterm"><div className="terminal-xterm-host" ref={container} /></div>
+      {extraKeys && <TerminalExtraKeys modifiers={modifiers} onKey={sendKey} onToggleModifier={toggleModifier} />}
+    </section>
+  )
+}
