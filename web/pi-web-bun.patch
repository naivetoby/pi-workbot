diff --git a/components/WorkbotTerminalAccess.test.mjs b/components/WorkbotTerminalAccess.test.mjs
new file mode 100644
index 0000000..821bb95
--- /dev/null
+++ b/components/WorkbotTerminalAccess.test.mjs
@@ -0,0 +1,279 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import { mock } from "bun:test";
+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { Script, createContext } from "node:vm";
+import ts from "typescript";
+
+// Keep this process-local mock at the transcript boundary, not the access guard.
+const viewers = [];
+mock.module("./WorkbotTranscript", () => ({
+  WorkbotTranscript(props) {
+    viewers.push(props);
+    return React.createElement("div", { "data-read-only-transcript": true });
+  },
+}));
+const { WorkbotTerminalAccess } = await import("./WorkbotTerminalAccess.tsx");
+
+function render(sessionPath, origin) {
+  viewers.length = 0;
+  let mounted = false;
+  function Chat() {
+    mounted = true;
+    return React.createElement("textarea", { "aria-label": "Message" });
+  }
+  const html = renderToStaticMarkup(React.createElement(
+    WorkbotTerminalAccess,
+    { session: { id: "fixture", path: sessionPath, name: "Fixture", origin }, running: false, onOpenFile() {} },
+    React.createElement(Chat),
+  ));
+  return { html, mounted };
+}
+
+test("explicit IM origin uses the live read-only transcript regardless of file location", () => {
+  for (const [adapter, label] of [["feishu", "飞书"], ["wecom", "企业微信"], ["custom-adapter", "IM"]]) {
+    const { html, mounted } = render("/runtime/pi/sessions/--workspace--/chat.jsonl", { kind: "im", adapter });
+    assert.equal(mounted, false, adapter);
+    assert.doesNotMatch(html, /textarea|打开 TUI/);
+    assert.ok(html.includes(`${label}会话 · 仅供查看，请回到${label}回复。`));
+    assert.match(html, /data-read-only-transcript/);
+    assert.equal(viewers.length, 1);
+    assert.equal(viewers[0].sessionId, "fixture");
+    assert.equal(viewers[0].running, true);
+    assert.equal(viewers[0].pollMs, 10_000);
+  }
+});
+
+test("new sessions retain chat and normal Web sessions wait for terminal status", () => {
+  for (const path of [undefined, ""]) {
+    const { html, mounted } = render(path);
+    assert.equal(mounted, true);
+    assert.match(html, /textarea/);
+  }
+  for (const path of [
+    "/runtime/pi/sessions/--workspace--/chat.jsonl",
+    "/runtime/pi/sessions/im/chat.jsonl",
+  ]) {
+    const { html, mounted } = render(path);
+    assert.equal(mounted, false);
+    assert.equal(html, "", "ownership checks must not render a viewer or a visible loading notice");
+    assert.equal(viewers.length, 0);
+  }
+});
+
+test("the access guard wraps the whole chat rather than only its input", () => {
+  const source = readFileSync(new URL("./AppShell.tsx", import.meta.url), "utf8");
+  assert.match(source, /<WorkbotTerminalAccess\b[^>]*>[\s\S]*?<ChatWindow\b[\s\S]*?<\/WorkbotTerminalAccess>/);
+});
+
+test("read-only transcripts use the same reactive font-size scope as GUI chat", async () => {
+  // Load the real viewer in isolation from the guard's module mock above.
+  const dependencies = {
+    react: React,
+    "./MessageView": { MessageView: () => null },
+    "./workbot-transcript-state": await import("./workbot-transcript-state.ts"),
+  };
+  const context = createContext({ exports: {}, require: (name) => dependencies[name], React });
+  new Script(ts.transpileModule(
+    readFileSync(new URL("./WorkbotTranscript.tsx", import.meta.url), "utf8"),
+    { compilerOptions: { target: ts.ScriptTarget.ESNext, module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.React } },
+  ).outputText).runInContext(context);
+
+  for (const running of [true, false]) {
+    const html = renderToStaticMarkup(React.createElement(context.exports.WorkbotTranscript, {
+      sessionId: "fixture", running, onOpenFile() {},
+    }));
+    assert.match(html, /^<div class="chat-content"/);
+  }
+  const css = readFileSync(new URL("../app/globals.css", import.meta.url), "utf8");
+  assert.match(css, /\.chat-content\s*\{\s*--chat-font-size-offset:\s*calc\(var\(--chat-content-font-size, 14px\) - 14px\)/);
+});
+
+// Run the real guard with local hook slots, following the upstream effect tests.
+// Only React scheduling/browser events are replaced; requests and render decisions
+// still execute the component body. No DOM package or model connection is needed.
+const guardScript = new Script(ts.transpileModule(
+  readFileSync(new URL("./WorkbotTerminalAccess.tsx", import.meta.url), "utf8"),
+  { compilerOptions: { target: ts.ScriptTarget.ESNext, module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.React } },
+).outputText);
+
+function mountGuard(fetch) {
+  const slots = [];
+  let cursor = 0;
+  let started = false;
+  let effect;
+  let cleanup;
+  const window = new EventTarget();
+  const document = Object.assign(new EventTarget(), { visibilityState: "visible" });
+  const react = {
+    ...React,
+    useState(initial) {
+      const index = cursor++;
+      if (!(index in slots)) slots[index] = initial;
+      return [slots[index], (value) => { slots[index] = typeof value === "function" ? value(slots[index]) : value; }];
+    },
+    useRef(initial) {
+      const index = cursor++;
+      return slots[index] ??= { current: initial };
+    },
+    useEffect(callback) { if (!started) effect = callback; },
+  };
+  const dependencies = {
+    react,
+    "react-dom": { flushSync: (callback) => callback() },
+    "./WorkbotTranscript": { WorkbotTranscript: () => React.createElement("div", { "data-read-only-transcript": true }) },
+  };
+  const context = createContext({
+    exports: {}, require: (name) => dependencies[name], React, fetch, AbortSignal,
+    window, document, setInterval() { return 1; }, clearInterval() {},
+  });
+  guardScript.runInContext(context);
+  const render = () => {
+    cursor = 0;
+    const element = context.exports.WorkbotTerminalAccess({
+      session: { id: "fixture", path: "/runtime/pi/sessions/web/chat.jsonl" },
+      running: false, onOpenFile() {}, children: React.createElement("textarea"),
+    });
+    return renderToStaticMarkup(element);
+  };
+  const html = render();
+  started = true;
+  cleanup = effect();
+  return {
+    html,
+    // Drain mocked requests/state updates, rather than sleeping for readiness.
+    async settle() { await new Promise(setImmediate); return render(); },
+    focus() { window.dispatchEvent(new Event("focus")); },
+    dispose() { cleanup(); },
+  };
+}
+
+test("read-only transcript polls only context pages, pauses when hidden and aborts on unmount", async () => {
+  const requests = [];
+  const effects = [];
+  let poll;
+  let cleared = false;
+  const document = { visibilityState: "visible" };
+  const dependencies = {
+    react: {
+      ...React,
+      useEffect: (effect) => effects.push(effect),
+      useLayoutEffect() {},
+      useState: (initial) => [initial, () => {}],
+      useRef: (current) => ({ current }),
+      useMemo: (compute) => compute(),
+      useCallback: (callback) => callback,
+    },
+    "./MessageView": { MessageView: () => null },
+    "./workbot-transcript-state": await import("./workbot-transcript-state.ts"),
+  };
+  const context = createContext({
+    exports: {}, require: (name) => dependencies[name], React, document, AbortController, URLSearchParams,
+    fetch: async (url, options) => {
+      requests.push({ url, options });
+      return Response.json({ context: { messages: [], entryIds: [], hasMore: false } });
+    },
+    setInterval(callback, ms) { assert.equal(ms, 10_000); poll = callback; return 1; },
+    clearInterval() { cleared = true; },
+  });
+  new Script(ts.transpileModule(
+    readFileSync(new URL("./WorkbotTranscript.tsx", import.meta.url), "utf8"),
+    { compilerOptions: { target: ts.ScriptTarget.ESNext, module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.React } },
+  ).outputText).runInContext(context);
+  context.exports.WorkbotTranscript({ sessionId: "im/fixture", running: true, onOpenFile() {} });
+  const cleanups = effects.map((effect) => effect());
+  try {
+    await new Promise(setImmediate);
+    assert.equal(requests.length, 1);
+    document.visibilityState = "hidden";
+    poll();
+    assert.equal(requests.length, 1);
+    document.visibilityState = "visible";
+    poll();
+    await new Promise(setImmediate);
+    assert.equal(requests.length, 2);
+    for (const { url, options } of requests) {
+      assert.equal(url, "/api/sessions/im%2Ffixture/context?deferThinking=1&deferMedia=1&tail=100");
+      assert.equal(options.method, undefined, "only GET, never send a prompt or start an agent");
+    }
+  } finally { for (const cleanup of cleanups) cleanup?.(); }
+  assert.equal(cleared, true);
+  assert.equal(requests[0].options.signal.aborted, true);
+});
+
+test("read-only paging preserves older records and ignores stale pages after a branch change", async () => {
+  const { mergeTailPage, prependOlderPage, buildToolResultsMap } = await import("./workbot-transcript-state.ts");
+  const page = (ids, hasMore = true) => ({ messages: ids.map((id) => ({ role: "user", content: id })), entryIds: ids, oldestEntryId: ids[0], hasMore });
+  const current = page(["a", "b"]);
+  const merged = mergeTailPage(current, page(["b", "c"]));
+  assert.deepEqual(merged.entryIds, ["a", "b", "c"]);
+  assert.equal(merged.messages[1], current.messages[1]);
+  const earlier = prependOlderPage(merged, "a", page(["0"], false));
+  assert.deepEqual(earlier.entryIds, ["0", "a", "b", "c"]);
+  assert.equal(earlier.hasMore, false);
+  const switched = mergeTailPage(earlier, page(["x"]));
+  assert.deepEqual(switched.entryIds, ["x"]);
+  assert.equal(prependOlderPage(switched, "a", page(["old"])), switched);
+  const result = { role: "toolResult", toolCallId: "call", content: [] };
+  assert.equal(buildToolResultsMap([result]).get("call"), result);
+});
+
+const terminalUrl = `/tui/?arg=${"a".repeat(32)}`;
+
+test("idle GUI mounts only after both terminal detection and history refresh finish", async () => {
+  const terminal = Promise.withResolvers();
+  const records = Promise.withResolvers();
+  const requests = [];
+  const guard = mountGuard((url) => {
+    requests.push(url);
+    return url.endsWith("/terminal") ? terminal.promise : records.promise;
+  });
+  try {
+    assert.equal(guard.html, "");
+    terminal.resolve(Response.json({ enabled: true, active: false, url: terminalUrl }));
+    const refreshing = await guard.settle();
+    assert.deepEqual(requests, ["/api/sessions/fixture/terminal", "/api/sessions/fixture?force=1"]);
+    assert.equal(refreshing, "", "history refresh must also remain silent");
+    records.resolve(new Response("{}"));
+    const ready = await guard.settle();
+    assert.match(ready, /textarea/);
+    assert.doesNotMatch(ready, /data-read-only-transcript|正在检查会话状态/);
+  } finally { guard.dispose(); }
+});
+
+test("confirmed TUI ownership mounts the transcript directly without starting GUI", async () => {
+  const requests = [];
+  const guard = mountGuard(async (url) => {
+    requests.push(url);
+    return Response.json({ enabled: true, active: true, url: terminalUrl });
+  });
+  try {
+    assert.doesNotMatch(guard.html, /textarea|data-read-only-transcript/);
+    const ready = await guard.settle();
+    assert.match(ready, /此会话已在 TUI 中打开/);
+    assert.match(ready, /data-read-only-transcript/);
+    assert.doesNotMatch(ready, /textarea|正在检查会话状态/);
+    assert.deepEqual(requests, ["/api/sessions/fixture/terminal"]);
+  } finally { guard.dispose(); }
+});
+
+test("failed detection exposes retry without either viewer, then recovers on recheck", async () => {
+  let attempts = 0;
+  const guard = mountGuard(async () => {
+    if (++attempts === 1) throw new Error("状态检查失败");
+    return Response.json({ enabled: false, active: false });
+  });
+  try {
+    const failed = await guard.settle();
+    assert.match(failed, /状态检查失败/);
+    assert.match(failed, /重试检查/);
+    assert.doesNotMatch(failed, /textarea|data-read-only-transcript/);
+    guard.focus();
+    const recovered = await guard.settle();
+    assert.equal(attempts, 2);
+    assert.match(recovered, /textarea/);
+    assert.doesNotMatch(recovered, /data-read-only-transcript|状态检查失败|重试检查/);
+  } finally { guard.dispose(); }
+});
