+    assert.equal(focusCount, 0)
+    await Promise.resolve()
+    terminal.options.disableStdin = false
+    focusTerminalOnDesktop(terminal)
+    assert.equal(focusCount, 0)
+    // Restored tabs and switching back to an existing tab use the same policy.
+    focusTerminalOnDesktop(terminal)
+    assert.equal(focusCount, 0)
+    assert.deepEqual(queries, ['(any-pointer: coarse)', '(any-pointer: coarse)'])
+    coarse = false
+    focusTerminalOnDesktop(terminal)
+    assert.equal(focusCount, 1, 'desktop terminals still focus once ready')
+    terminal.options.disableStdin = true
+    focusTerminalOnDesktop(terminal)
+    assert.equal(focusCount, 1, 'disconnected desktop terminals stay unfocused')
+  } finally {
+    if (previousWindow) Object.defineProperty(globalThis, 'window', previousWindow)
+    else delete globalThis.window
+  }
+})
+
+test('both TerminalPanel autofocus paths use the touch-safe policy', () => {
+  const panel = readFileSync(new URL('../components/TerminalPanel.tsx', import.meta.url), 'utf8')
+  assert.match(panel, /if \(container\.offsetWidth && container\.offsetHeight\) focusTerminalOnDesktop\(terminal\)/)
+  assert.match(panel, /if \(active && terminalRef\.current\) focusTerminalOnDesktop\(terminalRef\.current\)/)
+  assert.doesNotMatch(panel, /\.focus\(/)
+})
+
+function fixture() {
+  const textarea = Object.assign(new EventTarget(), { selectionStart: 0, selectionEnd: 0 })
+  const element = new EventTarget()
+  const writes = []
+  let onKey = () => {}
+  const terminal = {
+    textarea, element, options: { disableStdin: false },
+    onKey(listener) { onKey = listener; return { dispose() { onKey = () => {} } } },
+    input(data, userInput) { writes.push({ data, userInput }) },
+  }
+  const detach = attachTerminalInput(terminal)
+  function commit(data, options = {}) {
+    const { cancelable = true, ...properties } = options
+    const event = Object.assign(new Event('beforeinput', { cancelable }), {
+      data, inputType: 'insertText', isComposing: false, ...properties,
+    })
+    textarea.dispatchEvent(event)
+    return event
+  }
+  return { terminal, textarea, element, writes, commit, detach, handledKey: () => onKey() }
+}
+
+for (const text of ['中文候选', '日本語', '한국어', '😊']) {
+  test(`candidate-only commit sends ${text} once without waiting for composition events`, () => {
+    const { element, commit, writes, detach } = fixture()
+    try {
+      element.dispatchEvent(new Event('keydown'))
+      assert.equal(commit(text).defaultPrevented, true)
+      assert.deepEqual(writes, [{ data: text, userInput: true }])
+    } finally { detach() }
+  })
+}
+
+test('successive and repeated candidates are not deduplicated by text', () => {
+  const { commit, writes, detach } = fixture()
+  try {
+    commit('中'); commit('中'); commit('文')
+    assert.deepEqual(writes.map(({ data }) => data), ['中', '中', '文'])
+  } finally { detach() }
+})
+
+test('native inline composition and its trailing insertText remain owned by xterm', async () => {
+  const { textarea, commit, writes, detach } = fixture()
+  try {
+    textarea.dispatchEvent(new Event('compositionstart'))
+    assert.equal(commit('zhong').defaultPrevented, false)
+    textarea.dispatchEvent(new Event('compositionend'))
+    assert.equal(commit('中').defaultPrevented, false)
+    // Flush the adapter's composition-finalization task, not a readiness sleep.
+    await new Promise((resolve) => setTimeout(resolve, 0))
+    assert.equal(commit('文').defaultPrevented, true)
+    assert.deepEqual(writes.map(({ data }) => data), ['文'])
+  } finally { detach() }
+})
+
+test('a handled physical key is not sent again; the next IME key can commit', () => {
+  const { element, handledKey, commit, writes, detach } = fixture()
+  try {
+    element.dispatchEvent(new Event('keydown'))
+    handledKey()
+    assert.equal(commit('A').defaultPrevented, false)
+    element.dispatchEvent(new Event('keyup'))
+    element.dispatchEvent(new Event('keydown'))
+    assert.equal(commit('中').defaultPrevented, true)
+    assert.deepEqual(writes.map(({ data }) => data), ['中'])
+  } finally { detach() }
+})
+
+test('non-cancellable, composing, paste, deletion and empty events stay native', () => {
+  const { commit, writes, detach } = fixture()
+  try {
+    for (const options of [
+      { cancelable: false }, { isComposing: true },
+      { inputType: 'insertCompositionText' }, { inputType: 'insertFromPaste' },
+      { inputType: 'deleteContentBackward' },
+    ]) assert.equal(commit('中', options).defaultPrevented, false)
+    assert.equal(commit(null).defaultPrevented, false)
+    assert.equal(commit('').defaultPrevented, false)
+    assert.deepEqual(writes, [])
+  } finally { detach() }
+})
+
+test('replacement commits are accepted only without replacing a selected range', () => {
+  const { textarea, commit, writes, detach } = fixture()
+  try {
+    assert.equal(commit('候选', { inputType: 'insertReplacementText' }).defaultPrevented, true)
+    textarea.selectionEnd = 2
+    assert.equal(commit('纠错', { inputType: 'insertReplacementText' }).defaultPrevented, false)
+    assert.deepEqual(writes.map(({ data }) => data), ['候选'])
+  } finally { detach() }
+})
+
+test('disconnected terminals do not accept commits, and blur resets stale composition state', () => {
+  const { terminal, textarea, commit, writes, detach } = fixture()
+  try {
+    terminal.options.disableStdin = true
+    assert.equal(commit('中').defaultPrevented, false)
+    terminal.options.disableStdin = false
+    textarea.dispatchEvent(new Event('compositionstart'))
+    textarea.dispatchEvent(new Event('blur'))
+    assert.equal(commit('文').defaultPrevented, true)
+    assert.deepEqual(writes.map(({ data }) => data), ['文'])
+  } finally { detach() }
+})
+
+test('cleanup removes listeners and cancels pending composition state', () => {
+  const { textarea, commit, writes, detach } = fixture()
+  textarea.dispatchEvent(new Event('compositionend'))
+  detach()
+  assert.equal(commit('中').defaultPrevented, false)
+  assert.deepEqual(writes, [])
+})
