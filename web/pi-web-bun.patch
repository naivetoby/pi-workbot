+++ b/components/WorkbotTerminalAccess.tsx
@@ -0,0 +1,119 @@
+"use client";
+
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { flushSync } from "react-dom";
+import type { SessionInfo } from "@/lib/types";
+import { WorkbotTranscript } from "./WorkbotTranscript";
+
+type Status = { enabled: boolean; active: boolean; url?: string };
+
+/** A launcher and read-only notice, never a terminal renderer or process owner. */
+export function WorkbotTerminalAccess({ session, running, onOpenFile, children }: {
+  session: SessionInfo | null;
+  running: boolean;
+  onOpenFile: (path: string, page?: number) => void;
+  children: ReactNode;
+}) {
+  const isImSession = session?.origin?.kind === "im";
+  const channel = session?.origin?.adapter === "feishu" ? "飞书" : session?.origin?.adapter === "wecom" ? "企业微信" : "IM";
+  const eligible = Boolean(session?.path && !session.transient && session.relation?.kind !== "subagent" && !isImSession);
+  const [status, setStatus] = useState<Status | null>(null);
+  const [error, setError] = useState("");
+  const [opening, setOpening] = useState(false);
+  const busy = useRef(false);
+  const revision = useRef(0);
+  const refreshRecords = useRef(true);
+  const mounted = useRef(false);
+  const refresh = useRef<() => void>(() => {});
+  const url = `/api/sessions/${encodeURIComponent(session?.id ?? "")}/terminal`;
+
+  async function request(method: string): Promise<Status> {
+    const response = await fetch(url, { method, cache: "no-store", signal: AbortSignal.timeout(15_000) });
+    const value: unknown = await response.json();
+    if (!response.ok) throw new Error(value && typeof value === "object" && "error" in value && typeof value.error === "string" ? value.error : `HTTP ${response.status}`);
+    if (!value || typeof value !== "object" || !("enabled" in value) || typeof value.enabled !== "boolean"
+      || !("active" in value) || typeof value.active !== "boolean"
+      || (value.enabled && (!("url" in value) || typeof value.url !== "string" || !/^\/tui\/\?arg=[a-f0-9]{32}$/.test(value.url)))) throw new Error("无效的终端状态");
+    return value as Status;
+  }
+
+  useEffect(() => {
+    mounted.current = true;
+    let cancelled = false;
+    let checking = false;
+    const check = async () => {
+      if (!eligible || cancelled || checking || busy.current) return;
+      checking = true;
+      const current = revision.current;
+      try {
+        const next = await request("GET");
+        if (next.enabled && !next.active && refreshRecords.current) {
+          const records = await fetch(`/api/sessions/${encodeURIComponent(session!.id)}?force=1`, { cache: "no-store", signal: AbortSignal.timeout(15_000) });
+          if (!records.ok) throw new Error("无法刷新会话记录，请重试");
+        }
+        if (!cancelled && !busy.current && current === revision.current) { refreshRecords.current = next.active; setStatus(next); setError(""); }
+      } catch (reason) {
+        if (!cancelled && current === revision.current) { setStatus(null); setError(reason instanceof Error ? reason.message : String(reason)); }
+      } finally { checking = false; }
+    };
+    refresh.current = () => void check();
+    void check();
+    const visible = () => { if (document.visibilityState === "visible") void check(); };
+    const timer = setInterval(visible, 10_000);
+    window.addEventListener("focus", visible);
+    document.addEventListener("visibilitychange", visible);
+    return () => {
+      cancelled = true;
+      mounted.current = false;
+      clearInterval(timer);
+      window.removeEventListener("focus", visible);
+      document.removeEventListener("visibilitychange", visible);
+    };
+    // The parent keys this component by session; request only depends on its URL.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [url, eligible]);
+
+  async function open() {
+    if (busy.current || running) return;
+    // Open synchronously under the user's click, before asynchronous handoff.
+    const tab = window.open("about:blank", "_blank");
+    if (!tab) { setError("浏览器阻止了新标签页，请允许弹出窗口后重试"); return; }
+    tab.opener = null;
+    busy.current = true;
+    revision.current++;
+    flushSync(() => { setOpening(true); setError(""); });
+    try {
+      const next = await request("POST");
+      if (!next.active || !next.url) throw new Error("终端未就绪");
+      tab.location.replace(next.url);
+      if (mounted.current) { refreshRecords.current = true; setStatus(next); }
+    } catch (reason) {
+      tab.close();
+      // A lost response may still have started Pi. Recheck before remounting GUI.
+      if (mounted.current) { setStatus(null); setError(reason instanceof Error ? reason.message : String(reason)); }
+    } finally {
+      busy.current = false;
+      if (mounted.current) { setOpening(false); refresh.current(); }
+    }
+  }
+
+  if (!eligible && !isImSession) return children;
+  // Keep ownership checks silent. Mounting either viewer early causes a second
+  // history load and a visible layout swap, even if only shown behind a notice.
+  const pending = !isImSession && (opening || !status);
+  const readOnly = isImSession || status?.active;
+  if (pending && !error) return null;
+  return (
+    <section style={{ height: "100%", display: "flex", flexDirection: "column", minHeight: 0 }}>
+      {(isImSession || status?.enabled || opening) && <div role="note" style={{ padding: "8px 12px", borderBottom: "1px solid var(--border)", fontSize: 12, color: "var(--text-muted)" }}>
+        {isImSession ? `${channel}会话 · 仅供查看，请回到${channel}回复。` : status?.active ? "此会话已在 TUI 中打开，当前页面仅供查看。" : opening ? "正在打开独立终端…" : null}
+        {!isImSession && (status?.active && status.url ? <a href={status.url} target="_blank" rel="noopener noreferrer">打开 TUI ↗</a>
+          : status?.enabled && <button type="button" disabled={opening || running} onClick={() => void open()}>打开 TUI ↗</button>)}
+      </div>}
+      {error && <div role="alert" style={{ padding: "8px 12px" }}>{error} <button type="button" onClick={() => refresh.current()}>重试检查</button></div>}
+      <div style={{ flex: 1, minHeight: 0, overflow: "hidden" }}>
+        {pending ? null : readOnly && session ? <WorkbotTranscript key={session.id} sessionId={session.id} cwd={session.cwd} running={isImSession || Boolean(status?.active)} onOpenFile={onOpenFile} pollMs={10_000} /> : children}
+      </div>
+    </section>
+  );
+}
