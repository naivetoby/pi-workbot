new file mode 100644
index 0000000..79c5200
--- /dev/null
+++ b/lib/workbot-origin.ts
@@ -0,0 +1,18 @@
+export interface WorkbotOrigin {
+  kind: "im";
+  adapter: string;
+}
+
+/** Only the bridge's leading custom entry identifies the owning channel.
+ * Bind it to the session ID so copied history in a Web fork is not IM-owned. */
+export function readWorkbotOrigin(entries: readonly unknown[], sessionId: string): WorkbotOrigin | undefined {
+  const entry = entries[0];
+  if (!entry || typeof entry !== "object" || !("type" in entry) || entry.type !== "custom"
+    || !("customType" in entry) || entry.customType !== "workbot.origin" || !("data" in entry)) return undefined;
+  const data = entry.data;
+  if (!data || typeof data !== "object" || !("kind" in data) || data.kind !== "im"
+    || !("sessionId" in data) || data.sessionId !== sessionId
+    || !("adapter" in data) || typeof data.adapter !== "string"
+    || !/^[a-zA-Z0-9_-][a-zA-Z0-9._-]*$/.test(data.adapter)) return undefined;
+  return { kind: "im", adapter: data.adapter };
+}
