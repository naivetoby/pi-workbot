new file mode 100644
index 0000000..9dfb596
--- /dev/null
+++ b/lib/workbot-terminal-touch.ts
@@ -0,0 +1,54 @@
+import type { Terminal } from '@xterm/xterm'
+
+// xterm 6 handles wheel events but does not translate touch gestures for mouse-tracking apps.
+// Keep Pi/tmux in charge of history instead of scrolling a second browser-side buffer.
+export function attachTerminalTouchScroll(terminal: Terminal): () => void {
+  const element = terminal.element!
+  const screen = element.querySelector<HTMLElement>('.xterm-screen')!
+  const Wheel = element.ownerDocument.defaultView!.WheelEvent
+  let touch: { id: number; x: number; y: number; lastY: number; scrolling: boolean } | null = null
+  const enabled = () => !terminal.options.disableStdin && terminal.modes.mouseTrackingMode !== 'none'
+  const reset = () => { touch = null }
+  const start = (event: TouchEvent) => {
+    reset()
+    if (!enabled() || event.touches.length !== 1) return
+    const point = event.touches[0]
+    touch = { id: point.identifier, x: point.clientX, y: point.clientY, lastY: point.clientY, scrolling: false }
+  }
+  const move = (event: TouchEvent) => {
+    if (!touch) return
+    const point = event.touches[0]
+    if (!enabled() || event.touches.length !== 1 || point.identifier !== touch.id) {
+      reset()
+      return
+    }
+    if (!touch.scrolling) {
+      const dx = Math.abs(point.clientX - touch.x)
+      const dy = Math.abs(point.clientY - touch.y)
+      if (Math.max(dx, dy) < 6) return
+      if (dx > dy) { reset(); return }
+      touch.scrolling = true
+    }
+    event.preventDefault()
+    screen.dispatchEvent(new Wheel('wheel', {
+      bubbles: true,
+      cancelable: true,
+      clientX: point.clientX,
+      clientY: point.clientY,
+      deltaY: touch.lastY - point.clientY,
+      deltaMode: 0,
+    }))
+    touch.lastY = point.clientY
+  }
+  element.addEventListener('touchstart', start, { passive: true })
+  element.addEventListener('touchmove', move, { passive: false })
+  element.addEventListener('touchend', reset)
+  element.addEventListener('touchcancel', reset)
+  return () => {
+    reset()
+    element.removeEventListener('touchstart', start)
+    element.removeEventListener('touchmove', move)
+    element.removeEventListener('touchend', reset)
+    element.removeEventListener('touchcancel', reset)
+  }
+}
