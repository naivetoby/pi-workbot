diff --git a/lib/workbot-terminal-input.ts b/lib/workbot-terminal-input.ts
new file mode 100644
index 0000000..00baaf9
--- /dev/null
+++ b/lib/workbot-terminal-input.ts
@@ -0,0 +1,69 @@
+import type { Terminal } from '@xterm/xterm'
+
+// Mobile browsers may focus a readonly textarea without opening the keyboard,
+// then ignore focus() once stdin is enabled. Leave focus to xterm's tap handler
+// instead of acquiring it during mount or the asynchronous connection callback.
+export function focusTerminalOnDesktop(terminal: Terminal): void {
+  if (terminal.options.disableStdin) return
+  if (window.matchMedia('(any-pointer: coarse)').matches) return
+  terminal.focus()
+}
+
+// Candidate-only IMEs can commit long after keydown(229), without composition*.
+// xterm's textarea-diff timer has then expired, while _keyDownSeen still blocks
+// insertText. Own cancellable commits before the textarea changes, so neither
+// xterm's input handler nor its pending diff timer can send the text again.
+export function attachTerminalInput(terminal: Terminal): () => void {
+  const textarea = terminal.textarea
+  if (!textarea) return () => {}
+  let composing = false
+  let finishing = false
+  let keyHandled = false
+  let timer: ReturnType<typeof setTimeout> | undefined
+  const key = terminal.onKey(() => { keyHandled = true })
+  const resetKey = () => { keyHandled = false }
+  const start = () => {
+    clearTimeout(timer)
+    composing = true
+    finishing = false
+  }
+  const end = () => {
+    composing = false
+    finishing = true
+    // xterm finalizes composition on a zero-delay timer, including the trailing
+    // insertText that some browsers emit after compositionend.
+    clearTimeout(timer)
+    timer = setTimeout(() => { finishing = false }, 0)
+  }
+  const reset = () => {
+    clearTimeout(timer)
+    composing = finishing = keyHandled = false
+  }
+  const beforeInput = (event: InputEvent) => {
+    if (event.defaultPrevented || !event.cancelable || event.isComposing || composing || finishing || keyHandled) return
+    if (terminal.options.disableStdin || !event.data) return
+    if (event.inputType !== 'insertText' && event.inputType !== 'insertReplacementText') return
+    // Do not turn autocorrection of already-sent text into an extra insertion.
+    if (event.inputType === 'insertReplacementText' && textarea.selectionStart !== textarea.selectionEnd) return
+    event.preventDefault()
+    terminal.input(event.data, true)
+  }
+  // beforeinput is not used by xterm. Key resets run before its capture handler.
+  const host = terminal.element!
+  host.addEventListener('keydown', resetKey, true)
+  host.addEventListener('keyup', resetKey, true)
+  textarea.addEventListener('compositionstart', start)
+  textarea.addEventListener('compositionend', end)
+  textarea.addEventListener('beforeinput', beforeInput)
+  textarea.addEventListener('blur', reset)
+  return () => {
+    reset()
+    key.dispose()
+    host.removeEventListener('keydown', resetKey, true)
+    host.removeEventListener('keyup', resetKey, true)
+    textarea.removeEventListener('compositionstart', start)
+    textarea.removeEventListener('compositionend', end)
+    textarea.removeEventListener('beforeinput', beforeInput)
+    textarea.removeEventListener('blur', reset)
+  }
+}
