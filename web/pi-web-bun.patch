+import { NextResponse } from "next/server";
+import { realpath, stat } from "node:fs/promises";
+import { isAbsolute } from "node:path";
+import { SessionManager } from "@earendil-works/pi-coding-agent";
+import { resolveSessionPath, invalidateSessionManagerCache } from "@/lib/session-reader";
+import { getRpcSession, getRpcStartingSessionIds } from "@/lib/rpc-manager";
+import { hasActiveSessionLivenessProvider } from "@/lib/session-liveness";
+import { hasUnsettledSubagentRun } from "@/lib/subagent-runtime";
+import { readSubagentRun } from "@/lib/subagents";
+import { readWorkbotOrigin } from "@/lib/workbot-origin";
+import { terminalEnabled, terminalActive, terminalUrl, startTerminal } from "@/lib/workbot-terminal";
+
+type Context = { params: Promise<{ id: string }> };
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+
+export async function GET(_req: Request, { params }: Context) {
+  const { id } = await params;
+  if (!terminalEnabled()) return NextResponse.json({ enabled: false, active: false });
+  try {
+    return NextResponse.json({ enabled: true, active: await terminalActive(id), url: terminalUrl(id) });
+  } catch {
+    return NextResponse.json({ error: "无法查询终端状态，请稍后重试" }, { status: 503 });
+  }
+}
+
+export async function POST(_req: Request, { params }: Context) {
+  if (!terminalEnabled()) return NextResponse.json({ error: "独立终端未启用" }, { status: 403 });
+  const { id } = await params;
+  try {
+    const path = await resolveSessionPath(id);
+    if (!path) return NextResponse.json({ error: "会话不存在" }, { status: 404 });
+    const file = await realpath(path);
+    const manager = SessionManager.open(file);
+    const header = manager.getHeader();
+    if (header && readWorkbotOrigin(manager.getEntries(), header.id)) {
+      return NextResponse.json({ error: "请在 IM 中继续此会话" }, { status: 403 });
+    }
+    if (!header || header.id !== id || !isAbsolute(header.cwd) || !(await stat(header.cwd)).isDirectory()
+      || readSubagentRun(manager.getEntries().filter((entry) => entry.type === "custom"), id, file)) {
+      return NextResponse.json({ error: "只能打开已保存的普通会话" }, { status: 400 });
+    }
+    if (await terminalActive(id)) return NextResponse.json({ enabled: true, active: true, url: terminalUrl(id) });
+    const wrapper = getRpcSession(id);
+    if (getRpcStartingSessionIds().includes(id) || (wrapper && !wrapper.canDetachForTerminal())
+      || hasUnsettledSubagentRun(id) || hasActiveSessionLivenessProvider({ sessionId: id, sessionFile: path })) {
+      return NextResponse.json({ error: "请先结束 GUI 中的任务和后台工作" }, { status: 409 });
+    }
+    // One-time handoff only. No persistent ownership map or terminal event stream.
+    await wrapper?.shutdown();
+    invalidateSessionManagerCache(path);
+    await startTerminal(id, header.cwd, file);
+    return NextResponse.json({ enabled: true, active: true, url: terminalUrl(id) });
+  } catch (error) {
+    console.error("[workbot-terminal] open failed", error);
+    return NextResponse.json({ error: "终端启动失败，请检查 Web 日志" }, { status: 500 });
+  }
+}
