+    touch('touchend', [])
+    touch('touchstart')
+    assert.equal(touch('touchmove', [[140, 204]]).defaultPrevented, false)
+    touch('touchmove', [[140, 280]])
+    assert.equal(wheels.length, 0)
+  } finally { detach() }
+})
