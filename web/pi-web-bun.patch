index 0000000..1bf2373
--- /dev/null
+++ b/lib/workbot-ttyd.ts
@@ -0,0 +1,125 @@
+import type { Terminal } from '@xterm/xterm'
+
+type Status = 'connecting' | 'ready' | 'exited' | 'error'
+
+/** Only the ttyd wire protocol lives here; process ownership stays with tmux. */
+export function connectTtyd(
+  terminal: Terminal,
+  onStatus: (status: Status) => void,
+  onError: (message: string) => void,
+) {
+  const base = window.location.pathname.replace(/\/+$/, '')
+  const encoder = new TextEncoder()
+  const decoder = new TextDecoder()
+  let socket: WebSocket | undefined
+  let request: AbortController | undefined
+  let retry: ReturnType<typeof setTimeout> | undefined
+  let revision = 0
+  let stopped = false
+  let ended = false
+
+  function disconnect() {
+    revision++
+    clearTimeout(retry)
+    request?.abort()
+    socket?.close()
+    socket = undefined
+    terminal.options.disableStdin = true
+  }
+
+  async function connect() {
+    if (stopped || ended || !navigator.onLine || socket) return
+    clearTimeout(retry)
+    const current = ++revision
+    request = new AbortController()
+    onStatus('connecting')
+    try {
+      const response = await fetch(`${base}/token`, {
+        cache: 'no-store',
+        signal: AbortSignal.any([request.signal, AbortSignal.timeout(15_000)]),
+      })
+      if (!response.ok) throw new Error(`终端认证失败（HTTP ${response.status}），请返回 Pi Web 重新登录`)
+      const token: unknown = await response.json()
+      if (!token || typeof token !== 'object' || !('token' in token) || typeof token.token !== 'string')
+        throw new Error('无效的 ttyd 认证响应')
+      if (stopped || current !== revision) return
+      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:'
+      const ws = new WebSocket(`${protocol}//${window.location.host}${base}/ws${window.location.search}`, ['tty'])
+      socket = ws
+      ws.binaryType = 'arraybuffer'
+      let pendingBytes = 0
+      let paused = false
+      const send = (data: string | Uint8Array<ArrayBuffer>) => {
+        if (ws.readyState === WebSocket.OPEN) ws.send(data)
+      }
+      ws.onopen = () => {
+        if (current !== revision) return
+        terminal.reset()
+        send(encoder.encode(JSON.stringify({ AuthToken: token.token, columns: terminal.cols, rows: terminal.rows })))
+        terminal.options.disableStdin = false
+        onError('')
+        onStatus('ready')
+      }
+      ws.onmessage = (event: MessageEvent<unknown>) => {
+        if (current !== revision || !(event.data instanceof ArrayBuffer)) return
+        const bytes = new Uint8Array(event.data)
+        if (bytes[0] === 48) {
+          const output = bytes.subarray(1)
+          pendingBytes += output.byteLength
+          if (!paused && pendingBytes > 100_000) { paused = true; send(encoder.encode('2')) }
+          terminal.write(output, () => {
+            pendingBytes -= output.byteLength
+            if (paused && pendingBytes < 10_000) { paused = false; send(encoder.encode('3')) }
+          })
+        } else if (bytes[0] === 49) {
+          document.title = `${decoder.decode(bytes.subarray(1))} · Pi TUI`
+        }
+        // ttyd's preferences frame is intentionally ignored: Pi Web owns the appearance.
+      }
+      ws.onclose = (event) => {
+        if (stopped || current !== revision) return
+        socket = undefined
+        terminal.options.disableStdin = true
+        ended = event.code === 1000
+        onStatus(ended ? 'exited' : 'connecting')
+        if (!ended && navigator.onLine) retry = setTimeout(() => void connect(), 3000)
+      }
+      ws.onerror = () => {
+        if (current === revision) onError('终端连接中断，正在尝试重新连接')
+      }
+    } catch (error) {
+      if (stopped || current !== revision) return
+      terminal.options.disableStdin = true
+      onStatus('error')
+      onError(error instanceof Error ? error.message : String(error))
+    }
+  }
+
+  const hide = () => { disconnect(); if (!ended) onStatus('connecting') }
+  const show = (event: PageTransitionEvent) => { if (event.persisted) void connect() }
+  const online = () => void connect()
+  window.addEventListener('pagehide', hide)
+  window.addEventListener('pageshow', show)
+  window.addEventListener('offline', hide)
+  window.addEventListener('online', online)
+  void connect()
+
+  return {
+    write(data: string) {
+      if (socket?.readyState === WebSocket.OPEN) socket.send(encoder.encode(`0${data}`))
+    },
+    resize(cols: number, rows: number) {
+      if (socket?.readyState === WebSocket.OPEN)
+        socket.send(encoder.encode(`1${JSON.stringify({ columns: cols, rows })}`))
+    },
+    reconnect() { disconnect(); ended = false; void connect() },
+    dispose() {
+      stopped = true
+      disconnect()
+      window.removeEventListener('pagehide', hide)
+      window.removeEventListener('pageshow', show)
+      window.removeEventListener('offline', hide)
+      window.removeEventListener('online', online)
+    },
+  }
+}
