@@ -0,0 +1,63 @@
+import type { Terminal } from '@xterm/xterm'
+import { TERMINAL_XTERM_THEMES, type TerminalTheme } from './terminal-theme'
+
+export function terminalThemeReport(theme: TerminalTheme): string {
+  return `\x1b[?997;${theme === 'light' ? 2 : 1}n`
+}
+
+/** Shared by both pages; transports only deliver the selected theme to their PTY. */
+export function createTerminalThemeSync(
+  terminal: Pick<Terminal, 'options'>,
+  initialTheme: TerminalTheme,
+  send: (theme: TerminalTheme) => void | Promise<void>,
+  onError: (error: Error) => void,
+) {
+  let theme = initialTheme
+  let connected = false
+  let disposed = false
+  let revision = 0
+  let pending = Promise.resolve()
+  function sync() {
+    const current = ++revision
+    pending = pending.then(async () => {
+      if (disposed || !connected || current !== revision || !theme) return
+      await send(theme)
+    }).catch((error) => {
+      if (!disposed && current === revision) onError(error instanceof Error ? error : new Error(String(error)))
+    })
+    return pending
+  }
+  return {
+    setTheme(next: TerminalTheme) {
+      terminal.options.theme = TERMINAL_XTERM_THEMES[next]
+      if (theme === next) return pending
+      theme = next
+      return connected ? sync() : pending
+    },
+    // Connecting/restoring a terminal is not a user theme change. Never send input here.
+    setConnected(next: boolean) {
+      connected = next
+      if (!next) revision++
+    },
+    dispose() { disposed = true; revision++ },
+  }
+}
+
+/** Keep DEC mode 2031 independently of the bounded replay buffer. Shells never opt in. */
+export function createTerminalThemeTracker() {
+  let enabled = false
+  let partial = ''
+  return {
+    get enabled() { return enabled },
+    write(data: string) {
+      const input = partial + data
+      for (const match of input.matchAll(/\x1bc|\x1b\[\?([\d;]+)([hl])/g)) {
+        if (match[0] === '\x1bc') enabled = false
+        else if (match[1].split(';').includes('2031')) enabled = match[2] === 'h'
+      }
+      // Only an incomplete escape sequence can straddle PTY chunks, never retain output history.
+      const tail = input.slice(input.lastIndexOf('\x1b'))
+      partial = tail.length <= 128 && /^\x1b(?:\[\??[\d;]*)?$/.test(tail) ? tail : ''
+    },
+  }
+}
