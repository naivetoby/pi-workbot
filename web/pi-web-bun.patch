+import { NextResponse } from "next/server";
+import { syncTerminalTheme, terminalEnabled } from "@/lib/workbot-terminal";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+
+// Uses the same /api authentication and same-origin checks as terminal launch.
+export async function POST(req: Request) {
+  if (!terminalEnabled()) return NextResponse.json({ error: "独立终端未启用" }, { status: 403 });
+  const body: unknown = await req.json().catch(() => null);
+  if (!body || typeof body !== "object" || !("key" in body) || typeof body.key !== "string"
+    || !/^[a-f0-9]{32}$/.test(body.key) || !("theme" in body)
+    || (body.theme !== "dark" && body.theme !== "light")) {
+    return NextResponse.json({ error: "无效的终端主题请求" }, { status: 400 });
+  }
+  try {
+    await syncTerminalTheme(body.key, body.theme);
+    return new Response(null, { status: 204 });
+  } catch {
+    return NextResponse.json({ error: "终端主题同步失败，请重新连接" }, { status: 503 });
+  }
+}
