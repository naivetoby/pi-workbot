+    setModifiers(next)
+  }
+
+  return (
+    <section className="terminal-panel" data-terminal-theme={theme} aria-label="Pi TUI">
+      <header className="terminal-panel-header">
+        <div className="terminal-panel-path">
+          <span className={`terminal-status-dot is-${status}`} title={t(`terminal.${status}`)} />
+          <a href="/" target="_blank" rel="noopener noreferrer">Pi Web</a>
+        </div>
+        <div className="terminal-panel-actions" onMouseDown={(event) => event.preventDefault()}>
+          <button type="button" aria-label="减小字号" disabled={fontSize <= CHAT_CONTENT_FONT_SIZE_MIN} onClick={() => setFontSize(fontSize - 1)}>A−</button>
+          <span aria-label="终端字号">{terminalFontSize(fontSize)}</span>
+          <button type="button" aria-label="增大字号" disabled={fontSize >= CHAT_CONTENT_FONT_SIZE_MAX} onClick={() => setFontSize(fontSize + 1)}>A+</button>
