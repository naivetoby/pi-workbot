+test('theme route validates input, refuses disabled terminals, and reports missing panes without leaking errors', async () => {
+  const calls = []
+  let enabled = true
+  let fail = false
+  const route = loadModule('../app/api/workbot-terminal/theme/route.ts', {
+    'next/server': { NextResponse },
+    '@/lib/workbot-terminal': {
+      terminalEnabled: () => enabled,
+      syncTerminalTheme: async (...args) => {
+        calls.push(args)
+        if (fail) throw new Error('private socket path')
+      },
+    },
+  }, { Response })
+  const request = (body) => new Request('http://localhost/api/workbot-terminal/theme', {
+    method: 'POST', body: JSON.stringify(body),
+  })
+
+  for (const body of [null, [], {}, { key: '-t other', theme: 'dark' },
+    { key: 'a'.repeat(31), theme: 'dark' }, { key, theme: 'system' }, { key, theme: 1 }]) {
+    assert.equal((await route.POST(request(body))).status, 400)
+  }
+  assert.equal((await route.POST(new Request('http://localhost', { method: 'POST', body: '{' }))).status, 400)
+  enabled = false
+  assert.equal((await route.POST(request({ key, theme: 'dark' }))).status, 403)
+  assert.equal(calls.length, 0)
+
+  enabled = true
+  assert.equal((await route.POST(request({ key, theme: 'light' }))).status, 204)
+  assert.deepEqual(calls, [[key, 'light']])
+  fail = true
+  const response = await route.POST(request({ key, theme: 'dark' }))
+  assert.equal(response.status, 503)
+  assert.doesNotMatch(await response.text(), /private socket path/)
+})
+
+test('real Pi repaints existing user blocks in both directions and retains the draft and process', {
+  skip: !Bun.which('tmux'), timeout: 30_000,
+}, async () => {
+  const { SessionManager, getPackageDir } = await import('@earendil-works/pi-coding-agent')
+  const { syncTerminalTheme } = await import('./workbot-terminal.ts')
+  const root = await mkdtemp('/tmp/workbot-theme-')
+  const savedEnv = { ...process.env }
+  const exec = promisify(execFile)
+  const socket = join(root, 'tmux.sock')
+  const target = `=pi-${key}:0.0`
+  const tmux = async (...args) => (await exec('tmux', ['-S', socket, '-f', '/dev/null', ...args], {
+    env: process.env, timeout: 10_000,
+  })).stdout
+  let screen = ''
+  async function waitFor(label, check) {
+    const deadline = Date.now() + 10_000
+    while (Date.now() < deadline) {
+      screen = await tmux('capture-pane', '-ep', '-t', target)
+      if (check(screen)) return
+      await Bun.sleep(25)
+    }
+    throw new Error(`${label} timed out: ${JSON.stringify(screen)}`)
+  }
+  function userBackground(output) {
+    const end = output.indexOf('theme-user-message')
+    if (end < 0) return
+    const color = [...output.slice(0, end).matchAll(/\x1b\[[\d;]*48;2;(\d+);(\d+);(\d+)m/g)].at(-1)
+    return color && color.slice(1).map(Number)
+  }
+  try {
+    process.env = {
+      PATH: savedEnv.PATH, HOME: root, PI_CODING_AGENT_DIR: join(root, 'pi'),
+      PI_OFFLINE: '1', PI_TELEMETRY: '0', TERM: 'tmux-256color', COLORTERM: 'truecolor',
+      WORKBOT_TUI_ENABLED: '1', PI_WEB_PASSWORD: 'fixture-only',
+      WORKBOT_TMUX_SOCKET: socket, WORKBOT_TMUX_CONFIG: '/dev/null',
+    }
+    await mkdir(process.env.PI_CODING_AGENT_DIR, { recursive: true })
+    await Bun.write(join(process.env.PI_CODING_AGENT_DIR, 'settings.json'), JSON.stringify({
+      packages: [], theme: 'system', defaultProjectTrust: 'yes',
+    }))
+    const session = SessionManager.create(root, join(root, 'sessions'))
+    session.appendMessage({ role: 'user', content: 'theme-user-message', timestamp: Date.now() })
+    await tmux('new-session', '-d', '-x', '100', '-y', '40', '-s', `pi-${key}`, '--',
+      process.execPath, join(getPackageDir(), 'dist/bundle/cli.js'),
+      '--no-extensions', '--session', session.getSessionFile())
+    await waitFor('Pi startup', (output) => output.includes('theme-user-message'))
+    const pid = await tmux('display-message', '-p', '-t', target, '#{pane_pid}')
+    await tmux('send-keys', '-t', target, '-l', 'unsent-draft')
+    await waitFor('draft input', (output) => output.includes('unsent-draft'))
+    for (const theme of ['light', 'dark', 'light']) {
+      await syncTerminalTheme(key, theme)
+      await waitFor(`${theme} user background`, (output) => {
+        const rgb = userBackground(output)
+        return rgb && (theme === 'light' ? Math.min(...rgb) > 200 : Math.max(...rgb) < 100)
+      })
+      const rgb = userBackground(screen)
+      assert.ok(theme === 'light' ? Math.min(...rgb) > 200 : Math.max(...rgb) < 100)
+      assert.match(screen, /unsent-draft/)
+      assert.equal(await tmux('display-message', '-p', '-t', target, '#{pane_pid}'), pid)
+    }
+  } finally {
+    await tmux('kill-server').catch(() => {})
+    process.env = savedEnv
+    await rm(root, { recursive: true, force: true })
+  }
+})
