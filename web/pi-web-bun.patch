+function fixture() {
+  class WheelEvent extends Event {
+    constructor(type, { bubbles, cancelable, ...coordinates }) { super(type, { bubbles, cancelable }); Object.assign(this, coordinates) }
+  }
+  const screen = new EventTarget()
+  const wheels = []
+  screen.addEventListener('wheel', (event) => wheels.push(event))
+  const element = Object.assign(new EventTarget(), {
+    querySelector: () => screen,
+    ownerDocument: { defaultView: { WheelEvent } },
+  })
+  const terminal = { element, options: { disableStdin: false }, modes: { mouseTrackingMode: 'drag' } }
+  const detach = attachTerminalTouchScroll(terminal)
+  function touch(type, points = [[100, 200]]) {
+    const event = new Event(type, { cancelable: true })
+    event.touches = points.map(([clientX, clientY], identifier) => ({ clientX, clientY, identifier }))
+    element.dispatchEvent(event)
+    return event
+  }
+  return { terminal, wheels, touch, detach }
+}
+
