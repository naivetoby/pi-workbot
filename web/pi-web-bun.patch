+    assert.deepEqual(wheels.map(({ deltaY }) => deltaY), [-40, -20, 40])
+    assert.equal(wheels[0].clientX, 101)
+    assert.equal(wheels[0].clientY, 240)
+    assert.equal(wheels[0].deltaMode, 0)
+    assert.equal(wheels[0].bubbles, true)
+  } finally { detach() }
