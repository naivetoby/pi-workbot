diff --git a/lib/workbot-terminal.ts b/lib/workbot-terminal.ts
new file mode 100644
index 0000000..6db72f3
--- /dev/null
+++ b/lib/workbot-terminal.ts
@@ -0,0 +1,106 @@
+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { access, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { promisify } from "node:util";
+import { dirname, join } from "node:path";
+import { getPackageDir } from "@earendil-works/pi-coding-agent";
+import { TERMINAL_XTERM_THEMES, type TerminalTheme } from "./terminal-theme";
+import { terminalThemeReport } from "./workbot-terminal-theme";
+
+const exec = promisify(execFile);
+
+export function terminalEnabled(): boolean {
+  return process.env.WORKBOT_TUI_ENABLED === "1" && Boolean(process.env.PI_WEB_PASSWORD?.trim())
+    && Boolean(process.env.WORKBOT_TMUX_SOCKET && process.env.WORKBOT_TMUX_CONFIG);
+}
+
+export function terminalKey(id: string): string {
+  return createHash("sha256").update(id).digest("hex").slice(0, 32);
+}
+
+export function terminalUrl(id: string): string {
+  return `/tui/?arg=${terminalKey(id)}`;
+}
+
+async function tmux(args: string[]) {
+  if (!terminalEnabled()) throw new Error("独立终端未启用");
+  const { PI_WEB_PASSWORD: _password, ...env } = process.env;
+  return exec("tmux", ["-S", process.env.WORKBOT_TMUX_SOCKET!, "-f", process.env.WORKBOT_TMUX_CONFIG!, ...args], {
+    timeout: 10_000, maxBuffer: 64 * 1024, env,
+  });
+}
+
+export async function terminalActive(id: string): Promise<boolean> {
+  try {
+    await tmux(["has-session", "-t", `=pi-${terminalKey(id)}`]);
+    return true;
+  } catch (error) {
+    // A missing session/server is normal. Permission and executable failures
+    // must not silently make an occupied conversation writable again.
+    if (error && typeof error === "object" && "code" in error && error.code === 1
+      && "stderr" in error && typeof error.stderr === "string"
+      && /can't find session|no server running|No such file or directory|Connection refused/.test(error.stderr)) return false;
+    throw error;
+  }
+}
+
+/** Update what Pi's native OSC queries see, then ask its automatic theme to repaint. */
+export async function syncTerminalTheme(key: string, theme: TerminalTheme): Promise<void> {
+  if (!/^[a-f0-9]{32}$/.test(key) || (theme !== "dark" && theme !== "light"))
+    throw new Error("无效的终端主题请求");
+  const colors = TERMINAL_XTERM_THEMES[theme];
+  // Target only the managed Pi pane, never tmux's currently selected session/pane.
+  const target = `=pi-${key}:0.0`;
+  const { stdout } = await tmux([
+    "select-pane", "-t", target, "-P", `fg=${colors.foreground},bg=${colors.background}`,
+    ";", "display-message", "-p", "-t", target, "#{pane_tty}",
+  ]);
+  // A WebSocket can be ready before Pi starts. Never inject a report while the
+  // TTY still echoes input. Colours are already set for Pi's initial OSC query.
+  const { stdout: modes } = await exec("stty", [process.platform === "darwin" ? "-f" : "-F", stdout.trim(), "-a"], {
+    timeout: 10_000, env: { PATH: process.env.PATH, NODE_ENV: process.env.NODE_ENV, LC_ALL: "C" },
+  });
+  if (/(?:^|\s)-echo(?:\s|;|$)/.test(modes) && /(?:^|\s)-icanon(?:\s|;|$)/.test(modes))
+    await tmux(["send-keys", "-t", target, "-l", terminalThemeReport(theme)]);
+}
+
+export async function startTerminal(id: string, cwd: string, file: string): Promise<void> {
+  if (await terminalActive(id)) return;
+  const launcher = process.env.WORKBOT_TUI_LAUNCHER;
+  if (!launcher) throw new Error("缺少 TUI 启动器");
+  const directory = await mkdtemp(join(dirname(process.env.WORKBOT_TMUX_SOCKET!), "tui-launch-"));
+  const snapshot = join(directory, "env.json");
+  try {
+    // tmux retains its first server environment. Hand each new pane a fresh
+    // snapshot without putting credentials in argv or leaving a supervisor.
+    const { PI_WEB_PASSWORD: _password, ...env } = process.env;
+    await writeFile(snapshot, JSON.stringify(env), { mode: 0o600, flag: "wx" });
+    try {
+      // Multiple argv elements bypass tmux's single-string shell-command mode.
+      await tmux(["new-session", "-d", "-s", `pi-${terminalKey(id)}`, "-c", cwd,
+        "--", process.execPath, launcher, snapshot,
+        join(getPackageDir(), "dist/bundle/cli.js"), file]);
+    } catch (error) {
+      // Only an atomic name collision may reuse another request's process.
+      if (error && typeof error === "object" && "code" in error && error.code === 1
+        && "stderr" in error && typeof error.stderr === "string"
+        && error.stderr.includes("duplicate session:") && await terminalActive(id)) return;
+      throw error;
+    }
+    // The launcher unlinks the snapshot before execve. Bound its lifetime even
+    // when the launcher fails to start; never retain credentials after failure.
+    const deadline = Date.now() + 10_000;
+    while (true) {
+      try {
+        await access(snapshot);
+      } catch (error) {
+        if (error && typeof error === "object" && "code" in error && error.code === "ENOENT") break;
+        throw error;
+      }
+      if (Date.now() >= deadline) throw new Error("TUI 启动器未读取运行环境");
+      await new Promise((resolve) => setTimeout(resolve, 25));
+    }
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+}
