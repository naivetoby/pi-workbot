+
+function origin(adapter = "feishu", sessionId = "fixture") {
+  return { type: "custom", customType: "workbot.origin", data: { kind: "im", adapter, sessionId } };
+}
+
+test("only a leading, shaped, session-bound custom entry identifies IM origin", () => {
+  assert.deepEqual(readWorkbotOrigin([origin()], "fixture"), { kind: "im", adapter: "feishu" });
+  assert.deepEqual(readWorkbotOrigin([origin("wecom")], "fixture"), { kind: "im", adapter: "wecom" });
+  for (const entries of [
+    [], [null], ["workbot.origin"], [{ ...origin(), type: "message" }],
+    [{ ...origin(), customType: "other" }], [{ ...origin(), data: null }],
+    [{ ...origin(), data: { kind: "im", adapter: "feishu" } }],
+    [{ ...origin(), data: { kind: "web", adapter: "feishu", sessionId: "fixture" } }],
+    [origin("../feishu")], [origin(123)], [origin("feishu", "different-session")],
