+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { Script, createContext } from 'node:vm'
+import { promisify } from 'node:util'
+import { execFile } from 'node:child_process'
+import { mkdtemp, mkdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import test from 'node:test'
+import ts from 'typescript'
+import { NextResponse } from 'next/server'
+import { TERMINAL_XTERM_THEMES } from './terminal-theme.ts'
+import { createTerminalThemeSync, createTerminalThemeTracker, terminalThemeReport } from './workbot-terminal-theme.ts'
+
+function loadModule(path, dependencies, globals = {}) {
+  const context = createContext({ exports: {}, require: (name) => {
+    if (!(name in dependencies)) throw new Error(`Unexpected import: ${name}`)
+    return dependencies[name]
+  }, ...globals })
+  new Script(ts.transpileModule(readFileSync(new URL(path, import.meta.url), 'utf8'), {
+    compilerOptions: { target: ts.ScriptTarget.ESNext, module: ts.ModuleKind.CommonJS },
+  }).outputText).runInContext(context)
+  return context.exports
+}
+
+const key = 'a'.repeat(32)
+
+test('both pages initialize and reconnect without reports; only connected theme changes notify', async () => {
+  const terminal = { options: {} }
+  const reports = []
+  const errors = []
+  const sync = createTerminalThemeSync(terminal, 'dark', (theme) => { reports.push(theme) }, (error) => errors.push(error))
+  await sync.setTheme('dark')
+  sync.setConnected(true)
+  await sync.setTheme('dark')
+  sync.setConnected(false)
+  sync.setConnected(true)
+  await Promise.resolve()
+  assert.deepEqual(reports, [], 'startup, refresh and reconnect must not write terminal input')
+
+  await sync.setTheme('light')
+  await sync.setTheme('light')
+  assert.equal(terminal.options.theme.background, TERMINAL_XTERM_THEMES.light.background)
+  assert.deepEqual(reports, ['light'])
+  sync.setConnected(false)
+  await sync.setTheme('dark')
+  sync.setConnected(true)
+  await sync.setTheme('dark')
+  assert.deepEqual(reports, ['light'], 'offline changes are not replayed as input')
+  await sync.setTheme('light')
+  await sync.setTheme('dark')
+  assert.deepEqual(reports, ['light', 'light', 'dark'])
+  sync.dispose()
+  await sync.setTheme('light')
+  assert.deepEqual(reports, ['light', 'light', 'dark'])
+  assert.deepEqual(errors, [])
+})
+
+test('rapid switches serialize delivery and a failed request does not block the next switch', async () => {
+  const reports = []
+  const errors = []
+  let release
+  const gate = new Promise((resolve) => { release = resolve })
+  const sync = createTerminalThemeSync({ options: {} }, 'dark', async (theme) => {
+    reports.push(theme)
+    if (reports.length === 1) { await gate; throw new Error('offline') }
+  }, (error) => errors.push(error.message))
+  sync.setConnected(true)
+  const first = sync.setTheme('light')
+  await Promise.resolve()
+  const last = sync.setTheme('dark')
+  assert.deepEqual(reports, ['light'])
+  release()
+  await Promise.all([first, last])
+  assert.deepEqual(reports, ['light', 'dark'])
+  assert.deepEqual(errors, [], 'a superseded failure must not overwrite the current UI')
+  sync.dispose()
+})
+
+test('native theme subscription survives split PTY output and ignores ordinary shell text', () => {
+  const enable = '\x1b[?2004;2031h'
+  for (let split = 0; split <= enable.length; split++) {
+    const tracker = createTerminalThemeTracker()
+    tracker.write('shell$ 2031h')
+    assert.equal(tracker.enabled, false)
+    tracker.write(enable.slice(0, split))
+    tracker.write(enable.slice(split))
+    assert.equal(tracker.enabled, true)
+    tracker.write('output'.repeat(30_000))
+    assert.equal(tracker.enabled, true)
+    tracker.write('\x1b[?2031l')
+    assert.equal(tracker.enabled, false)
+    tracker.write(enable + '\x1bc')
+    assert.equal(tracker.enabled, false)
+  }
+})
+
+test('built-in PTY sends reports only to subscribed applications, even after history rolls over', async () => {
+  const writes = []
+  let output
+  const pty = {
+    onData(listener) { output = listener }, onExit() {},
+    write(data) { writes.push(data) }, resize() {}, kill() {},
+  }
+  const manager = loadModule('./terminal-manager.ts', {
+    crypto: { randomUUID: () => 'fixture' }, os: { homedir: () => '/tmp' },
+    '@earendil-works/pi-coding-agent': {}, './paths': { samePath: (a, b) => a === b },
+    './terminal-bun-pty': { spawnBunPty: () => pty },
+    './workbot-terminal-theme': { createTerminalThemeTracker, terminalThemeReport },
+  }, { Bun: {}, process: { env: {}, platform: 'linux', once() {} }, setTimeout, clearTimeout })
+  const id = manager.createTerminal('/tmp', 80, 24)
+  try {
+    manager.syncTerminalTheme(id, 'light')
+    assert.deepEqual(writes, [], 'plain shells must not receive theme control sequences')
+    output('\x1b[?20')
+    output('31h')
+    assert.deepEqual(writes, [], 'enabling a mode is not a user theme change')
+    manager.syncTerminalTheme(id, 'dark')
+    assert.deepEqual(writes, [terminalThemeReport('dark')])
+    output('x'.repeat(140_000))
+    const replay = manager.subscribeTerminal(id, () => {})
+    assert.equal(replay.output.data.includes('2031h'), false)
+    manager.syncTerminalTheme(id, 'light')
+    assert.deepEqual(writes, [terminalThemeReport('dark'), terminalThemeReport('light')])
+    replay.unsubscribe()
+    output('\x1b[?2031l')
+    manager.syncTerminalTheme(id, 'dark')
+    assert.equal(writes.length, 2, 'returning to a shell must disable notifications')
+  } finally {
+    manager.killTerminal(id, true)
+  }
+})
+
+test('theme sync updates only the managed pane before notifying Pi, without sending Web credentials', async () => {
+  const calls = []
+  let modes = '-echo -icanon'
+  const terminal = loadModule('./workbot-terminal.ts', {
+    'node:child_process': { execFile: (binary, args, options, done) => {
+      calls.push({ binary, args: [...args], options })
+      done(null, { stdout: binary === 'stty' ? modes : '/dev/pts/1\n', stderr: '' })
+    } },
+    'node:crypto': {}, 'node:fs/promises': {}, 'node:path': {},
+    'node:util': { promisify },
+    '@earendil-works/pi-coding-agent': {},
+    './terminal-theme': { TERMINAL_XTERM_THEMES },
+    './workbot-terminal-theme': { terminalThemeReport },
+  }, { process: { env: {
+    WORKBOT_TUI_ENABLED: '1', PI_WEB_PASSWORD: 'must-not-reach-tmux',
+    WORKBOT_TMUX_SOCKET: '/private/tui.sock', WORKBOT_TMUX_CONFIG: '/app/tmux.conf',
+  } } })
+
+  for (const theme of ['light', 'dark']) {
+    await terminal.syncTerminalTheme(key, theme)
+    const [style, tty, input] = calls.slice(-3)
+    const colors = TERMINAL_XTERM_THEMES[theme]
+    assert.equal(style.binary, 'tmux')
+    assert.deepEqual(style.args, [
+      '-S', '/private/tui.sock', '-f', '/app/tmux.conf',
+      'select-pane', '-t', `=pi-${key}:0.0`, '-P', `fg=${colors.foreground},bg=${colors.background}`,
+      ';', 'display-message', '-p', '-t', `=pi-${key}:0.0`, '#{pane_tty}',
+    ])
+    assert.equal(tty.binary, 'stty')
+    assert.deepEqual(tty.args, ['-F', '/dev/pts/1', '-a'])
+    assert.deepEqual(input.args.slice(4), ['send-keys', '-t', `=pi-${key}:0.0`, '-l', terminalThemeReport(theme)])
+    assert.ok([style, tty, input].every((call) => call.options.env.PI_WEB_PASSWORD === undefined))
+  }
+  await assert.rejects(terminal.syncTerminalTheme('-t other', 'dark'))
+  await assert.rejects(terminal.syncTerminalTheme(key, 'invalid'))
+  assert.equal(calls.length, 6)
+  for (modes of ['echo icanon', '-echo icanon', 'echo -icanon']) {
+    calls.length = 0
+    await terminal.syncTerminalTheme(key, 'dark')
+    assert.deepEqual(calls.map((call) => call.binary), ['tmux', 'stty'], 'startup must not receive a report before raw/no-echo mode')
+  }
+})
