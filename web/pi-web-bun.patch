+} from '@/lib/terminal-extra-keys'
+import { TerminalExtraKeys, useTerminalExtraKeysVisible } from '@/components/TerminalExtraKeys'
+import { connectTtyd } from '@/lib/workbot-ttyd'
+import { attachTerminalTouchScroll } from '@/lib/workbot-terminal-touch'
+import { attachTerminalInput } from '@/lib/workbot-terminal-input'
+import { createTerminalThemeSync } from '@/lib/workbot-terminal-theme'
