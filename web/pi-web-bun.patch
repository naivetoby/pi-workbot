+declare global {
+  interface Window {
+    term?: Terminal & { fit(): void }
+  }
+}
+
+function Tui() {
+  useViewportHeight()
+  useFontPreferences()
+  const { t } = useI18n()
+  const { fontSize, setFontSize } = useChatAppearance()
+  const theme = useTerminalTheme()
+  const extraKeys = useTerminalExtraKeysVisible()
